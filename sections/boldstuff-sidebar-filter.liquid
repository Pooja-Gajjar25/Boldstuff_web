{% comment %}
  Boldstuff Sidebar Filter Section
  Replicates the provided UI design with Schema settings and responsive behavior.
{% endcomment %}

<div class="bs-filter-section" id="bs-filter-{{ section.id }}">
  <div class="bs-filter-container">
    <div class="bs-filter-header">
      <h3 class="bs-filter-heading">{{ section.settings.title | default: 'Filters' }}</h3>
    </div>

    <form class="bs-filter-form">
      {% comment %} Capacity Filter {% endcomment %}
      <div class="bs-filter-group">
        <h4 class="bs-filter-group-title">Capacity <i class="fa fa-angle-up"></i></h4>
        <div class="bs-filter-options-list">
          {%- assign capacity_tags = '' -%}
          {%- for product in collection.products -%}
            {%- for tag in product.tags -%}
              {%- if tag contains 'L' -%}
                {%- unless capacity_tags contains tag -%}
                  {%- assign capacity_tags = capacity_tags | append: tag | append: ',' -%}
                {%- endunless -%}
              {%- endif -%}
            {%- endfor -%}
          {%- endfor -%}
          {%- assign unique_capacity = capacity_tags | split: ',' | uniq -%}
          {%- for cap in unique_capacity -%}
            {%- unless cap == '' -%}
              <label class="bs-checkbox-container">
                <input type="checkbox" name="capacity" value="{{ cap }}">
                <span class="bs-checkbox-box">
                  <svg
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="3"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <polyline points="20 6 9 17 4 12"></polyline>
                  </svg>
                </span>
                <span class="bs-checkbox-label">{{ cap }}</span>
              </label>
            {%- endunless -%}
          {%- endfor -%}
        </div>
      </div>

      {% comment %} Price Filter {% endcomment %}
      <div class="bs-filter-group">
        <h4 class="bs-filter-group-title">Price <i class="fa fa-angle-up"></i></h4>
        <div class="bs-price-range">
          <span class="bs-currency-symbol">₹500</span>
          <span class="bs-currency-symbol">₹2,000</span>
        </div>
        <div class="bs-range-slider-mockup">
          <div class="range-track">
            <div class="range-bar" style="left: 10%; width: 60%;"></div>
          </div>
          <div class="range-thumb left" style="left: 10%;"></div>
          <div class="range-thumb right" style="left: 70%;"></div>
        </div>
      </div>

      {% comment %} Features Filter {% endcomment %}
      <div class="bs-filter-group">
        <h4 class="bs-filter-group-title">Features <i class="fa fa-angle-up"></i></h4>
        <div class="bs-filter-options-list">
          <label class="bs-checkbox-container">
            <input type="checkbox" name="feature" value="Leakproof">
            <span class="bs-checkbox-box">
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="3"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <polyline points="20 6 9 17 4 12"></polyline>
              </svg>
            </span>
            <span class="bs-checkbox-label">Leakproof</span>
          </label>
          <label class="bs-checkbox-container">
            <input type="checkbox" name="feature" value="BPA Free">
            <span class="bs-checkbox-box">
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="3"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <polyline points="20 6 9 17 4 12"></polyline>
              </svg>
            </span>
            <span class="bs-checkbox-label">BPA Free</span>
          </label>
          <label class="bs-checkbox-container">
            <input type="checkbox" name="feature" value="Easy to Clean">
            <span class="bs-checkbox-box">
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="3"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <polyline points="20 6 9 17 4 12"></polyline>
              </svg>
            </span>
            <span class="bs-checkbox-label">Easy to Clean</span>
          </label>
          <label class="bs-checkbox-container">
            <input type="checkbox" name="feature" value="Double Wall Vacuum">
            <span class="bs-checkbox-box">
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="3"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <polyline points="20 6 9 17 4 12"></polyline>
              </svg>
            </span>
            <span class="bs-checkbox-label">Double Wall Vacuum</span>
          </label>
        </div>
      </div>

      {% comment %} Rating Filter {% endcomment %}
      <div class="bs-filter-group">
        <h4 class="bs-filter-group-title">Rating <i class="fa fa-angle-up"></i></h4>
        <div class="bs-filter-options-list">
          <label class="bs-checkbox-container">
            <input type="checkbox" name="rating" value="4">
            <span class="bs-rating-stars">
              <i class="fa fa-star"></i><i class="fa fa-star"></i><i class="fa fa-star"></i><i class="fa fa-star"></i
              ><i class="fa fa-star-o"></i>
            </span>
            <span class="bs-checkbox-label"> 4 Up</span>
          </label>
          <label class="bs-checkbox-container">
            <input type="checkbox" name="rating" value="3">
            <span class="bs-rating-stars">
              <i class="fa fa-star"></i><i class="fa fa-star"></i><i class="fa fa-star"></i><i class="fa fa-star-o"></i
              ><i class="fa fa-star-o"></i>
            </span>
            <span class="bs-checkbox-label"> 3 Up</span>
          </label>
        </div>
      </div>

      <div class="bs-filter-actions">
        <button type="button" class="bs-apply-btn">APPLY FILTERS</button>
        <button type="button" class="bs-clear-btn">CLEAR ALL</button>
      </div>
    </form>
  </div>
</div>

<style>
  /* Scoped styles for the filter section - White Theme */
  #bs-filter-{{ section.id }} {
    font-family: 'Inter', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
    color: #333333;
    padding: 0;
  }

  /* Container matching the card look */
  .bs-filter-container {
    background-color: #fcfcfc; /* Very Light Grey/White Sidebar Background */
    border: none;
    border-radius: 8px;
    padding: 0 20px 20px;
    max-width: 300px; /* Sidebar width constraint */
    width: 100%;
    margin: 0 auto; /* Center on mobile if full width */
    /* box-shadow: 0 4px 20px rgba(0,0,0,0.05); Removed shadow for cleaner look */
  }

  .bs-filter-header {
    border-bottom: none;
    padding-bottom: 20px;
    margin-bottom: 10px;
  }

  .bs-filter-heading {
    font-size: 24px;
    font-weight: 700;
    margin: 0;
    color: #111111;
    letter-spacing: -0.5px;
    font-family: 'Playfair Display', serif; /* Serif Heading */
  }

  .bs-filter-group {
    /* border-bottom: 1px solid #eeeeee; */
    padding-bottom: 15px;
    margin-bottom: 10px;
  }

  .bs-filter-group:last-child {
    border-bottom: none;
  }

  .bs-filter-group-title {
    font-size: 15px;
    font-weight: 500;
    margin: 0 0 16px 0;
    color: #333333;
    display: flex;
    justify-content: space-between;
    align-items: center;
    cursor: pointer;
  }

  .bs-filter-group-title i {
      font-size: 14px;
      color: #4697A0; /* Teal Arrow */
      transition: transform 0.2s;
  }

  /* Checkbox Styling */
  .bs-filter-options-list {
    display: flex;
    flex-direction: column;
    gap: 12px;
    margin-bottom: 10px;
  }

  .bs-checkbox-container {
    display: flex;
    align-items: center;
    gap: 12px;
    cursor: pointer;
    user-select: none;
    margin: 0;
  }

  .bs-checkbox-container input {
    display: none; /* Hide native checkbox */
  }

  .bs-checkbox-box {
    width: 18px;
    height: 18px;
    border: 1px solid #e0e0e0;
    border-radius: 3px;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.2s ease;
    background: #ffffff;
  }

  .bs-checkbox-box svg {
    width: 12px;
    height: 12px;
    opacity: 0;
    transform: scale(0.5);
    transition: all 0.2s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    color: #ffffff;
  }

  /* Checked State */
  .bs-checkbox-container input:checked + .bs-checkbox-box {
    background-color: #4697A0; /* Teal Background */
    border-color: #4697A0;
  }

  .bs-checkbox-container input:checked + .bs-checkbox-box svg {
    opacity: 1;
    transform: scale(1);
  }

  .bs-checkbox-label {
    font-size: 14px;
    font-weight: 400;
    color: #777777; /* Grey text for options */
  }

  /* Rating Stars */
  .bs-rating-stars {
      color: #FFB800; /* Gold */
      font-size: 14px;
      margin-right: 5px;
      display: flex;
      gap: 2px;
  }

  /* Price Range */
  .bs-price-range {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 10px;
  }

  .bs-currency-symbol {
    font-size: 14px;
    color: #333;
    font-weight: 500;
  }

  /* Mockup Range Slider */
  .bs-range-slider-mockup {
      position: relative;
      height: 4px; /* Track height */
      margin-top: 15px;
      margin-bottom: 15px;
      width: 100%;
  }

  .range-track {
      position: absolute;
      top: 0;
      bottom: 0;
      left: 0;
      right: 0;
      background: #e0e0e0; /* Grey inactive track */
      border-radius: 2px;
  }

  .range-bar {
      position: absolute;
      top: 0;
      bottom: 0;
      background: #4697A0; /* Teal active track */
      border-radius: 2px;
  }

  .range-thumb {
      position: absolute;
      top: 50%;
      width: 16px;
      height: 16px;
      background: #ffffff;
      border: 2px solid #e0e0e0; /* Grey border for thumb */
      border-radius: 50%;
      transform: translate(-50%, -50%);
      cursor: pointer;
      z-index: 2;
  }

  .bs-filter-actions {
      margin-top: 30px;
  }

  .bs-apply-btn {
    width: 100%;
    background-color: #4697A0; /* Teal */
    border: none;
    color: #ffffff;
    padding: 12px;
    border-radius: 4px;
    font-size: 13px;
    font-weight: 700;
    cursor: pointer;
    transition: background 0.2s;
    text-transform: uppercase;
    margin-bottom: 15px;
    letter-spacing: 0.5px;
  }

  .bs-apply-btn:hover {
    background-color: #387c84;
  }

  .bs-clear-btn {
      width: 100%;
      background: transparent;
      border: none;
      color: #4697A0; /* Teal Text */
      font-size: 12px;
      font-weight: 600;
      text-transform: uppercase;
      cursor: pointer;
      padding: 5px;
      letter-spacing: 0.5px;
  }

  .bs-clear-btn:hover {
      text-decoration: underline;
  }

  /* Mobile Responsive */
  @media (max-width: 768px) {
    .bs-filter-container {
      max-width: 100%; /* Full width on mobile if needed */
      padding: 0 10px 20px;
    }
  }
</style>

{% schema %}
{
  "name": "Sidebar Filter",
  "settings": [
    {
      "type": "image_picker",
      "id": "bg_image",
      "label": "Section Background Image"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Section Title",
      "default": "Filters"
    }
  ],
  "presets": [
    {
      "name": "Sidebar Filter"
    }
  ]
}
{% endschema %}
