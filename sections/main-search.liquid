<div class="main-collection-grid-wrapper page-width">
  <div class="row">
    {%- if settings.show_search -%}
      <div class="col-lg-3 col-md-12 col-sm-12 col-xs-12 normal-sidebar sidebar_content">
        {% render 'ishi-sidebar-content' %}
      </div>
    {%- endif -%}

    <div class="normal_main_content {% if settings.show_search %}col-lg-9 col-md-12 col-sm-12 col-xs-12{% else %}col-12{% endif %}">
      <div class="collection-top-bar">
        <div class="breadcrumb-wrapper">
          <nav class="breadcrumb" aria-label="breadcrumbs">
            <span class="breadcrumb-label">Home</span>
            <span class="divider">/</span>
            <span class="breadcrumb-current">{{ 'general.search.search' | t }}</span>
          </nav>
        </div>
        <div class="search-result-count" style="font-weight: 500; font-size: 14px;">
          {% if search.performed %}
            {{ 'templates.search.results_with_count' | t: terms: search.terms, count: search.results_count }}
          {% else %}
            {{ 'general.search.search' | t }}
          {% endif %}
        </div>
      </div>

      <script src="{{ 'facets.js' | asset_url }}" defer="defer"></script>
      {% render 'facets', results: search, enable_sorting: section.settings.enable_sorting %}

      <div id="ProductGridContainer">
        {%- paginate search.results by section.settings.products_per_page -%}
          {%- if search.results.size == 0 -%}
            <div class="collection collection--empty" id="product-grid" data-id="{{ section.id }}">
              <div class="loading-overlay">
                <div class="loading-overlay__spinner">
                  <svg
                    aria-hidden="true"
                    focusable="false"
                    role="presentation"
                    class="spinner"
                    viewBox="0 0 66 66"
                    xmlns="http://www.w3.org/2000/svg"
                  >
                    <circle class="path" fill="none" stroke-width="6" cx="33" cy="33" r="30"></circle>
                  </svg>
                </div>
              </div>

              <div class="title-wrapper center">
                <div class="title alert-danger alert">
                  {{ 'sections.facets.empty' | t }}
                </div>
              </div>
            </div>
          {%- else -%}
            <div class="collection">
              <div class="loading-overlay">
                <div class="loading-overlay__spinner">
                  <svg
                    aria-hidden="true"
                    focusable="false"
                    role="presentation"
                    class="spinner"
                    viewBox="0 0 66 66"
                    xmlns="http://www.w3.org/2000/svg"
                  >
                    <circle class="path" fill="none" stroke-width="6" cx="33" cy="33" r="30"></circle>
                  </svg>
                </div>
              </div>

              <ul id="product-grid" data-id="{{ section.id }}" class="row">
                {% assign i = 1 %}
                {%- for product in search.results -%}
                  <li class="grid__item col-lg-4 col-md-6 col-sm-6 col-xs-6">
                    {% render 'product-card-grid',
                      product_card_product: product,
                      media_size: settings.image_ratio,
                      product_count: i,
                      show_secondary_image: settings.show_secondary_image,
                      show_vendor: settings.show_vendor
                    %}
                    {% assign i = i | plus: 1 %}
                  </li>
                {%- endfor -%}
              </ul>

              {%- if paginate.pages > 1 -%}
                <div class="pagination-block row align-items-center">
                  <p class="collection-product-count col-md-6" role="status">
                    {% assign current_first_item = paginate.current_offset | plus: 1 %}
                    {% if paginate.pages == paginate.current_page %}
                      {% assign current_last_item = paginate.items %}
                    {% else %}
                      {% assign current_last_item = paginate.current_offset | plus: paginate.page_size %}
                    {% endif %}
                    {{ 'general.pagination.showing' | t }}
                    {{ current_first_item }}-{{ current_last_item }}
                    {{ 'general.pagination.of' | t }}
                    {{ paginate.items }}
                    {{ 'general.pagination.items' | t }}
                  </p>
                  <div class="col-md-6 pagination-view">
                    {% render 'pagination', paginate: paginate, anchor: '', class: '' %}
                  </div>
                </div>
              {%- endif -%}
            </div>
          {%- endif -%}
        {%- endpaginate -%}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Search Results",
  "tag": "section",
  "class": "spaced-section",
  "settings": [
    {
      "type": "range",
      "id": "products_per_page",
      "min": 8,
      "max": 24,
      "step": 4,
      "default": 16,
      "label": "t:sections.main-collection-product-grid.settings.products_per_page.label"
    },
    {
      "type": "header",
      "content": "Sorting"
    },
    {
      "type": "checkbox",
      "id": "enable_sorting",
      "default": true,
      "label": "t:sections.main-collection-product-grid.settings.enable_sorting.label"
    }
  ],
  "blocks": [
    {
      "type": "sidebar_link",
      "name": "Sidebar Link",
      "limit": 1,
      "settings": [
        {
          "type": "link_list",
          "id": "sidebar_link",
          "label": "Category Links"
        }
      ]
    },
    {
      "type": "filter",
      "name": "Filter",
      "limit": 1,
      "settings": []
    },
    {
      "type": "collection",
      "name": "Collection",
      "settings": [
        {
          "type": "text",
          "id": "product_title",
          "label": "Main Title",
          "default": "Collection Title"
        },
        {
          "id": "collection",
          "type": "collection",
          "label": "Collection"
        },
        {
          "type": "range",
          "id": "grid",
          "label": "Products To Display",
          "min": 2,
          "max": 5,
          "step": 1,
          "default": 3
        },
        {
          "type": "checkbox",
          "id": "show_view_all",
          "label": "Show 'View All'",
          "default": false
        }
      ]
    },
    {
      "type": "banner",
      "name": "Banner",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "url",
          "id": "banner_link",
          "label": "Link"
        },
        {
          "type": "select",
          "id": "hover1",
          "label": "Hover Effect",
          "default": "fadeinnormal",
          "options": [
            { "value": "fadeinnormal", "label": "FadeIn Normal" },
            { "value": "fadeinflip", "label": "FadeIn Flip" }
          ]
        }
      ]
    }
  ]
}
{% endschema %}

<style>
  .main-collection-grid-wrapper {
    background: #ffffff;
    color: #333333;
    padding: 30px;
  }
  .main-collection-grid-wrapper .row {
    margin: 0;
  }

  .collection-top-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    background: #ffffff;
    padding: 0 20px;
    border: none;
    height: 50px;
    margin-bottom: 20px;
  }

  /* Sidebar Styling */
  .sidebar_content {
    background: transparent !important;
    padding: 0 !important;
    border: none !important;
  }

  /* Hide default filter title since we added a custom header */
  .facets__heading {
    display: none !important;
  }

  .mb-3 {
    margin-bottom: 20px;
  }

  .breadcrumb {
    margin: 0;
    padding: 0;
    background: transparent;
    font-size: 14px;
    color: #555;
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .breadcrumb-label {
    color: #555;
    font-weight: 500;
  }

  .breadcrumb-current {
    color: #999;
  }

  .sort-by-wrapper {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .sort-label {
    margin: 0;
    font-weight: 500;
    color: #555;
    font-size: 14px;
  }

  .select-wrapper {
    position: relative;
    display: flex;
    align-items: center;
  }

  .sort-select {
    background: transparent;
    border: none;
    color: #333;
    font-weight: 600;
    padding-right: 20px;
    appearance: none;
    cursor: pointer;
    font-size: 14px;
    outline: none;
  }

  .select-wrapper i {
    position: absolute;
    right: 0;
    pointer-events: none;
    font-size: 10px;
    color: #333;
  }

  .sidebar-title {
    color: #111 !important;
    font-size: 16px !important;
    font-weight: 800 !important;
    font-family: 'Playfair Display', serif;
    text-transform: capitalize;
    letter-spacing: 0;
    margin-bottom: 20px !important;
    border-bottom: none;
    padding-bottom: 10px;
  }

  /* Facets / Filters */
  .facets__form {
    padding: 0 20px;
  }

  .facets__summary span {
    color: #333;
    font-weight: 600;
    font-size: 14px;
  }

  /* Price Range */
  .field {
    flex: 1;
    position: relative;
    background: #f9f9f9;
    border: 1px solid #ddd;
    border-radius: 4px;
    padding: 10px;
  }
  .field__input {
    background: transparent !important;
    border: none !important;
    color: #333 !important;
  }
  .field__currency {
    color: #555;
  }

  /* Grid Content */
  .normal_main_content {
    background: #ffffff;
    padding: 0 !important;
  }

  @media (min-width: 992px) {
    .normal_main_content {
      padding-left: 40px !important;
    }
  }

  /* Showing X Products text */
  .collection-product-count {
    color: #666;
    font-size: 14px;
    margin: 0;
  }

  .pagination-block {
    background-color: #ffffff;
    padding: 20px 0;
    border-top: 1px solid #eeeeee;
    position: sticky;
    bottom: 0;
    z-index: 99;
    width: 100%;
    margin-top: 30px;
    box-shadow: 0 -4px 10px rgba(0, 0, 0, 0.05);
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .pagination__item {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    background-color: #f4f4f4 !important;
    color: #333333 !important;
    border: none !important;
    border-radius: 4px;
    font-weight: 600;
    transition: all 0.2s ease;
  }

  .pagination__item--current {
    background-color: #4697a0 !important;
    color: #ffffff !important;
  }

  .pagination__item:hover {
    background-color: #e0e0e0 !important;
  }

  .pagination__item-arrow {
    background-color: #f4f4f4 !important;
  }
</style>
