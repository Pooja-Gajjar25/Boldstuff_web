{% comment %}
  Boldstuff Header Section
  Designed to match the provided requirements and UI from the BOLDSTUFF screenshot.
{% endcomment %}

{% style %}
  :root {
    --header-bg-color: #ffffff;
    --header-accent-color: {{ section.settings.accent_color | default: '#4697A0' }};
    --header-text-color: #000000;
    --header-border-color: #e5e5e5;
  }

  .boldstuff-header {
    width: 100%;
    font-family: 'Inter', sans-serif;
    z-index: 1000;
    position: relative;
    background: var(--header-bg-color);
    box-shadow: 0 1px 2px rgba(0,0,0,0.05);
  }

  .boldstuff-section-divider {
    display: none;
  }

  /* Announcement Bar */
  .header-announcement-bar {
    background-color: #f8f8f8;
    color: #111;
    padding: 8px 0;
    font-size: 12px;
    font-weight: 500;
    border-bottom: 1px solid #eee;
  }

  .header-announcement-bar .container {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 20px;
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 20px;
  }

  /* Top Bar */
  .header-top-bar {
    background-color: #fff;
    color: #666;
    padding: 6px 0;
    font-size: 12px;
    border-bottom: 1px solid #f0f0f0;
  }

  .header-top-bar .container {
    display: flex;
    justify-content: flex-end;
    align-items: center;
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 20px;
  }

  .top-bar-item {
    margin-left: 20px;
    color: #666;
    text-decoration: none;
    display: flex;
    align-items: center;
    gap: 6px;
    transition: color 0.2s;
  }

  .top-bar-item:hover {
    color: var(--header-accent-color);
  }

  /* Main Header */
  .header-main-bar {
    padding: 15px 0;
    background: #ffffff;
    border-bottom: 1px solid #f0f0f0;
  }

  .header-main-bar .container {
    display: flex;
    justify-content: space-between;
    align-items: center;
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 20px;
  }

  /* Logo */
  .header-logo .logo-text {
    font-size: 24px;
    font-weight: 800;
    text-transform: uppercase;
    color: #000;
    text-decoration: none;
    letter-spacing: -0.5px;
    display: flex;
    align-items: center;
  }

  .header-logo .logo-text span {
    color: var(--header-accent-color);
  }

  .header-logo img {
    height: 35px;
    width: auto;
  }

  /* Center Pill: Combined Nav + Search */
  .header-center-pill {
    display: flex;
    align-items: center;
    background-color: #f3f4f6; /* Light grey pill bg */
    border-radius: 6px;
    padding: 4px 6px 4px 15px;
    flex: 0 1 700px; /* Width constraint */
    justify-content: space-between;
    margin: 0 20px;
  }

  .header-nav-inline ul {
    display: flex;
    list-style: none;
    margin: 0;
    padding: 0;
    align-items: center;
  }

  .header-nav-link {
    color: #555;
    text-decoration: none;
    font-size: 13px;
    font-weight: 500;
    padding: 6px 10px;
    position: relative;
    white-space: nowrap;
    transition: color 0.2s;
  }

  .header-nav-link:hover {
    color: #000;
  }

  .header-nav-link.active {
    color: #000;
    font-weight: 600;
  }

  .header-nav-link.active::after {
    content: '';
    position: absolute;
    bottom: 2px;
    left: 10px;
    right: 10px;
    height: 2px;
    background-color: var(--header-accent-color);
  }

  .nav-separator {
    color: #ccc;
    font-size: 12px;
    margin: 0 2px;
  }

  /* Embedded Search Input */
  .header-search-inline {
    display: flex;
    align-items: center;
    background: #e5e7eb; /* Slightly darker grey for input area? Or match pill? Screenshot looks slightly distinct or just an input box */
    /* Screenshot: Search looks like a standard input on the right side */
    background: #fff; /* White background for search input to stand out from pill? No, screenshot looks like light grey input on light grey background maybe? */
    /* Looking at screenshot again: The search part has a border or is a slightly different shade. Let's make it simple. */
    background: rgba(255,255,255,0.5);
    border-radius: 4px;
    padding: 4px 10px;
    margin-left: 15px;
    min-width: 200px;
  }

  .header-search-inline form {
    display: flex;
    align-items: center;
    width: 100%;
  }

  .header-search-inline input {
    border: none;
    background: transparent;
    font-size: 13px;
    color: #333;
    width: 100%;
    outline: none;
  }

  .header-search-inline button {
    background: none;
    border: none;
    padding: 0;
    color: #888;
    cursor: pointer;
  }

  /* Right Actions */
  .header-actions {
    display: flex;
    align-items: center;
    gap: 15px;
  }

  .action-icon {
    color: #000;
    font-size: 20px;
    text-decoration: none;
    position: relative;
  }

  .cart-count-badge {
    position: absolute;
    top: -5px;
    right: -8px;
    background: var(--header-accent-color);
    color: #fff;
    font-size: 10px;
    width: 16px;
    height: 16px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .mobile-menu-trigger {
    display: none;
    font-size: 20px;
    color: #000;
    cursor: pointer;
  }

  @media (max-width: 991px) {
    .header-center-pill { display: none; } /* Hide complex nav on mobile */
    .mobile-menu-trigger { display: block; }
    .header-top-bar { display: none; }
  }
{% endstyle %}

<div class="boldstuff-header" id="section-{{ section.id }}">
  <!-- Announcement -->
  {% if section.blocks.size > 0 %}
    <div class="header-announcement-bar">
      <div class="container">
        {% for block in section.blocks %}
          {% if block.type == 'announcement' %}
            <div class="announcement-item">
              {% if block.settings.icon != blank %}
                <img
                  src="{{ block.settings.icon | image_url: width: 40 }}"
                  alt=""
                  class="announcement-icon"
                  loading="lazy"
                  width="20"
                  height="20"
                >
              {% endif %}
              <span>{{ block.settings.text }}</span>
            </div>
          {% endif %}
        {% endfor %}
      </div>
    </div>
  {% endif %}

  <!-- Top Bar (Optional) -->
  {% if section.settings.show_top_bar %}
    <div class="header-top-bar">
      <div class="container">
        <a href="{{ routes.account_url }}" class="top-bar-item">Account</a>
        <a href="{{ routes.cart_url }}" class="top-bar-item">Cart</a>
      </div>
    </div>
  {% endif %}

  <!-- Main Bar -->
  <div class="header-main-bar">
    <div class="container">
      <!-- Left: Mobile Menu & Logo -->
      <div style="display:flex; align-items:center; gap:15px;">
        <div class="mobile-menu-trigger hidden-lg-up">
          <i class="fa fa-bars"></i>
        </div>
        <div class="header-logo">
          <a href="{{ routes.root_url }}" class="logo-text">
            {% if section.settings.logo != blank %}
              <img
                src="{{ section.settings.logo | image_url: width: 300 }}"
                alt="{{ shop.name }}"
                width="{{ section.settings.logo.width }}"
                height="{{ section.settings.logo.height }}"
                loading="lazy"
              >
            {% else %}
              BOLD<span>STUFF</span>
            {% endif %}
          </a>
        </div>
      </div>

      <!-- Center: Combined Pill -->
      <div class="header-center-pill hidden-md-down">
        <nav class="header-nav-inline">
          <ul>
            {% for link in section.settings.menu.links %}
              <li>
                <a href="{{ link.url }}" class="header-nav-link {% if link.active %}active{% endif %}">
                  {{ link.title }}
                </a>
              </li>
              {% unless forloop.last %}
                <li class="nav-separator">|</li>
              {% endunless %}
            {% endfor %}
          </ul>
        </nav>

        <div class="header-search-inline">
          <form action="{{ routes.search_url }}" method="get" role="search">
            <button type="submit"><i class="fa fa-search"></i></button>
            <input type="search" name="q" placeholder="Search" value="{{ search.terms | escape }}">
            <input type="hidden" name="type" value="product">
            <input type="hidden" name="options[prefix]" value="last">
          </form>
        </div>
      </div>

      <!-- Right: Actions -->
      <div class="header-actions">
        <!-- Search icon for mobile -->
        <a href="{{ routes.search_url }}" class="action-icon hidden-lg-up">
          <i class="fa fa-search"></i>
        </a>

        <a href="{{ routes.account_url }}" class="action-icon">
          <i class="fa fa-user-o"></i>
          <!-- Outline user icon -->
        </a>

        <a href="{{ routes.cart_url }}" class="action-icon">
          <i class="fa fa-shopping-bag"></i>
          {% if cart.item_count > 0 %}
            <span class="cart-count-badge">{{ cart.item_count }}</span>
          {% endif %}
        </a>
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Boldstuff Header",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_top_bar",
      "label": "Show Top Bar",
      "default": true
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo Image"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Menu",
      "default": "main-menu"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent Color",
      "default": "#4697A0"
    }
  ],
  "blocks": [
    {
      "type": "announcement",
      "name": "Announcement",
      "settings": [
        { "type": "text", "id": "text", "label": "Text" },
        { "type": "image_picker", "id": "icon", "label": "Icon" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Boldstuff Header"
    }
  ]
}
{% endschema %}
